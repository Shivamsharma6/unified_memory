# UAMS API Settings
UAMS_API_PORT=8000
UAMS_API_URL=http://localhost:8000

# LLM Configuration (Options: ollama, openai, mock)
# Default relies on local Ollama to ensure privacy and zero-cost local execution
UAMS_LLM_PROVIDER=ollama
UAMS_LLM_BASE_URL=http://localhost:11434
# UAMS_LLM_API_KEY=your-api-key-here
# UAMS_LLM_MODEL=gemma4:12b-mlx

# Cloud Provider Example (OpenAI / Groq)
# UAMS_LLM_PROVIDER=openai
# UAMS_LLM_BASE_URL=https://api.openai.com/v1
# UAMS_LLM_API_KEY=sk-proj-...
# UAMS_LLM_MODEL=gpt-4o

# Embeddings Configuration (Options: ollama, openai, fastembed, fake)
UAMS_EMBED_PROVIDER=ollama
UAMS_EMBED_MODEL=mxbai-embed-large:335m
UAMS_EMBED_DIMENSION=1024
# UAMS_EMBED_API_KEY=your-api-key-here

# Cloud Embeddings Example (OpenAI)
# UAMS_EMBED_PROVIDER=openai
# UAMS_EMBED_MODEL=text-embedding-3-small
# UAMS_EMBED_DIMENSION=1536

# Qdrant Database Settings
# Localhost-only defaults. Change QDRANT_HOST only for trusted networks.
QDRANT_HOST=127.0.0.1
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_IMAGE=qdrant/qdrant:latest
