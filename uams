#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WATCHER_DIR="$ROOT_DIR/memory_watcher"
VENV_DIR="$WATCHER_DIR/.venv"
PID_DIR="$WATCHER_DIR/.pids"
API_PID_FILE="$PID_DIR/api.pid"
WATCHER_PID_FILE="$PID_DIR/watcher.pid"
API_LAUNCHD_LABEL="com.uams.api"
WATCHER_LAUNCHD_LABEL="com.uams.watcher"
ENV_FILE="$ROOT_DIR/.env"

# The repository-local .env file is the supported configuration boundary for
# every launcher command. It is trusted shell-compatible configuration; export
# its assignments so direct child processes and Docker Compose see the same
# values.
if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

# launchctl does not reliably preserve the environment of the invoking shell.
# Resolve and pass the complete runtime configuration to both long-lived jobs.
LAUNCHD_ENV=(
  "UAMS_VAULT_PATH=${UAMS_VAULT_PATH:-$ROOT_DIR}"
  "UAMS_API_HOST=${UAMS_API_HOST:-127.0.0.1}"
  "UAMS_API_PORT=${UAMS_API_PORT:-8000}"
  "UAMS_API_URL=${UAMS_API_URL:-http://localhost:${UAMS_API_PORT:-8000}}"
  "UAMS_POSTGRES_HOST=${UAMS_POSTGRES_HOST:-127.0.0.1}"
  "UAMS_POSTGRES_PORT=${UAMS_POSTGRES_PORT:-5432}"
  "UAMS_POSTGRES_DB=${UAMS_POSTGRES_DB:-uams}"
  "UAMS_POSTGRES_USER=${UAMS_POSTGRES_USER:-uams}"
  "UAMS_POSTGRES_PASSWORD=${UAMS_POSTGRES_PASSWORD:-uams-local-only}"
  "UAMS_POSTGRES_POOL_MIN=${UAMS_POSTGRES_POOL_MIN:-1}"
  "UAMS_POSTGRES_POOL_MAX=${UAMS_POSTGRES_POOL_MAX:-10}"
  "UAMS_POSTGRES_CONNECT_TIMEOUT=${UAMS_POSTGRES_CONNECT_TIMEOUT:-5}"
  "QDRANT_HOST=${QDRANT_HOST:-127.0.0.1}"
  "QDRANT_HTTP_PORT=${QDRANT_HTTP_PORT:-6333}"
  "QDRANT_GRPC_PORT=${QDRANT_GRPC_PORT:-6334}"
  "UAMS_EMBED_PROVIDER=${UAMS_EMBED_PROVIDER:-ollama}"
  "UAMS_EMBED_MODEL=${UAMS_EMBED_MODEL:-mxbai-embed-large:335m}"
  "UAMS_EMBED_DIMENSION=${UAMS_EMBED_DIMENSION:-1024}"
  "UAMS_EMBED_API_KEY=${UAMS_EMBED_API_KEY:-}"
  "UAMS_LLM_PROVIDER=${UAMS_LLM_PROVIDER:-ollama}"
  "UAMS_LLM_BASE_URL=${UAMS_LLM_BASE_URL:-http://localhost:11434}"
  "UAMS_LLM_MODEL=${UAMS_LLM_MODEL:-gemma4:12b-mlx}"
  "UAMS_LLM_API_KEY=${UAMS_LLM_API_KEY:-}"
  "PYTHONPATH=$WATCHER_DIR"
)

usage() {
  echo "Usage: ./uams {install|start|stop [--infra]|restart|status|migrate|embed-upgrade|lint|projection-status|index|logs|mcp|mcp-config|doctor|integrate}"
}

compose_cmd() {
  if docker compose version >/dev/null 2>&1; then
    echo "docker compose"
  elif command -v docker-compose >/dev/null 2>&1; then
    echo "docker-compose"
  else
    echo "Docker Compose is required. Install Docker Desktop, OrbStack, or docker-compose." >&2
    exit 1
  fi
}

require_venv() {
  if [ ! -x "$VENV_DIR/bin/python" ]; then
    echo "UAMS is not installed yet. Run ./install.sh first."
    exit 1
  fi
}

process_matches() {
  local pid="$1"
  local pattern="$2"
  local command
  command="$(ps -p "$pid" -o command= 2>/dev/null || true)"
  [ -n "$command" ] && [[ "$command" =~ $pattern ]]
}

is_running() {
  local pid_file="$1"
  local pattern="${2:-}"
  [ -f "$pid_file" ] || return 1
  local pid
  pid="$(cat "$pid_file")"
  kill -0 "$pid" >/dev/null 2>&1 || return 1
  [ -z "$pattern" ] || process_matches "$pid" "$pattern"
}

launchd_available() {
  [ "$(uname -s)" = "Darwin" ] && command -v launchctl >/dev/null 2>&1
}

launchd_running() {
  local label="$1"
  launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1
}

stop_launchd() {
  local name="$1"
  local label="$2"
  if launchd_running "$label"; then
    launchctl remove "$label"
    echo "$name stopped."
  else
    echo "$name is not running."
  fi
}

start_infra() {
  if ! docker info >/dev/null 2>&1; then
    echo "Docker is not running. Start Docker Desktop or OrbStack first."
    exit 1
  fi
  local compose
  compose="$(compose_cmd)"
  (cd "$WATCHER_DIR" && $compose up -d --wait postgres qdrant)
}

apply_schema() {
  PYTHONPATH="$WATCHER_DIR" "$VENV_DIR/bin/python" \
    "$WATCHER_DIR/scripts/migrate_control_plane.py" --schema-only
}

wait_ready() {
  local url="http://${UAMS_API_HOST:-127.0.0.1}:${UAMS_API_PORT:-8000}/ready"
  local attempts="${UAMS_READY_ATTEMPTS:-180}"
  local response=""
  for ((attempt = 1; attempt <= attempts; attempt++)); do
    if response="$(curl -fsS "$url" 2>/dev/null)"; then
      echo "UAMS readiness passed."
      return
    fi
    sleep 1
  done
  echo "UAMS did not become ready after ${attempts}s." >&2
  curl -sS "$url" 2>/dev/null || true
  echo >&2
  exit 1
}

start_api() {
  if launchd_available; then
    if launchd_running "$API_LAUNCHD_LABEL"; then
      echo "API already running under launchd."
      return
    fi
    mkdir -p "$PID_DIR"
    launchctl submit -l "$API_LAUNCHD_LABEL" \
      -o "$WATCHER_DIR/api.log" -e "$WATCHER_DIR/api.log" -- \
      /usr/bin/env \
      "${LAUNCHD_ENV[@]}" \
      "$VENV_DIR/bin/python" -m uvicorn api.main:app \
      --app-dir "$WATCHER_DIR" \
      --host "${UAMS_API_HOST:-127.0.0.1}" --port "${UAMS_API_PORT:-8000}"
    sleep 1
    if launchd_running "$API_LAUNCHD_LABEL"; then
      echo "API started under launchd."
      return
    fi
    echo "API failed to stay running. Check $WATCHER_DIR/api.log." >&2
    exit 1
  fi
  if is_running "$API_PID_FILE" "uvicorn .*api.main:app|python.*-m uvicorn .*api.main:app"; then
    echo "API already running on PID $(cat "$API_PID_FILE")."
    return
  fi
  mkdir -p "$PID_DIR"
  (cd "$WATCHER_DIR"; nohup "$VENV_DIR/bin/python" -m uvicorn api.main:app --host "${UAMS_API_HOST:-127.0.0.1}" --port "${UAMS_API_PORT:-8000}" > api.log 2>&1 & echo $! > "$API_PID_FILE")
  sleep 1
  if is_running "$API_PID_FILE" "uvicorn .*api.main:app|python.*-m uvicorn .*api.main:app"; then
    echo "API started on PID $(cat "$API_PID_FILE")."
  else
    rm -f "$API_PID_FILE"
    echo "API failed to stay running. Check $WATCHER_DIR/api.log." >&2
    exit 1
  fi
}

start_watcher() {
  if launchd_available; then
    if launchd_running "$WATCHER_LAUNCHD_LABEL"; then
      echo "Watcher already running under launchd."
      return
    fi
    mkdir -p "$PID_DIR"
    launchctl submit -l "$WATCHER_LAUNCHD_LABEL" \
      -o "$WATCHER_DIR/watcher.log" -e "$WATCHER_DIR/watcher.log" -- \
      /usr/bin/env \
      "${LAUNCHD_ENV[@]}" \
      "$VENV_DIR/bin/python" "$WATCHER_DIR/main.py"
    sleep 1
    if launchd_running "$WATCHER_LAUNCHD_LABEL"; then
      echo "Watcher started under launchd."
      return
    fi
    echo "Watcher failed to stay running. Check $WATCHER_DIR/watcher.log." >&2
    exit 1
  fi
  if is_running "$WATCHER_PID_FILE" "python.*main.py"; then
    echo "Watcher already running on PID $(cat "$WATCHER_PID_FILE")."
    return
  fi
  mkdir -p "$PID_DIR"
  (cd "$WATCHER_DIR"; nohup "$VENV_DIR/bin/python" main.py > watcher.log 2>&1 & echo $! > "$WATCHER_PID_FILE")
  sleep 1
  if is_running "$WATCHER_PID_FILE" "python.*main.py"; then
    echo "Watcher started on PID $(cat "$WATCHER_PID_FILE")."
  else
    rm -f "$WATCHER_PID_FILE"
    echo "Watcher failed to stay running. Check $WATCHER_DIR/watcher.log." >&2
    exit 1
  fi
}

stop_one() {
  local name="$1"
  local pid_file="$2"
  local pattern="$3"
  if is_running "$pid_file" "$pattern"; then
    kill "$(cat "$pid_file")"
    echo "$name stopped."
  elif [ -f "$pid_file" ]; then
    echo "$name has a stale PID file; removing it."
  else
    echo "$name is not running."
  fi
  rm -f "$pid_file"
}

case "${1:-}" in
  install)
    exec "$ROOT_DIR/install.sh"
    ;;
  start)
    require_venv
    start_infra
    apply_schema
    start_watcher
    start_api
    wait_ready
    echo "UAMS is online: http://${UAMS_API_HOST:-127.0.0.1}:${UAMS_API_PORT:-8000}/docs"
    ;;
  stop)
    if launchd_available; then
      stop_launchd "Watcher" "$WATCHER_LAUNCHD_LABEL"
      stop_launchd "API" "$API_LAUNCHD_LABEL"
    else
      stop_one "Watcher" "$WATCHER_PID_FILE" "python.*main.py"
      stop_one "API" "$API_PID_FILE" "uvicorn .*api.main:app|python.*-m uvicorn .*api.main:app"
    fi
    if [ "${2:-}" = "--infra" ]; then
      compose="$(compose_cmd)"
      (cd "$WATCHER_DIR" && $compose stop postgres qdrant)
      echo "PostgreSQL and Qdrant stopped; named volumes were preserved."
    fi
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  status)
    if launchd_available; then
      if launchd_running "$API_LAUNCHD_LABEL"; then echo "API: running under launchd"; else echo "API: stopped"; fi
      if launchd_running "$WATCHER_LAUNCHD_LABEL"; then echo "Watcher: running under launchd"; else echo "Watcher: stopped"; fi
    else
      if is_running "$API_PID_FILE" "uvicorn .*api.main:app|python.*-m uvicorn .*api.main:app"; then echo "API: running on PID $(cat "$API_PID_FILE")"; else echo "API: stopped"; fi
      if is_running "$WATCHER_PID_FILE" "python.*main.py"; then echo "Watcher: running on PID $(cat "$WATCHER_PID_FILE")"; else echo "Watcher: stopped"; fi
    fi
    if ! docker info >/dev/null 2>&1; then
      echo "PostgreSQL/Qdrant: unknown (Docker is not running)"
    else
      compose="$(compose_cmd)"
      (cd "$WATCHER_DIR" && $compose ps postgres qdrant)
    fi
    if curl -fsS "http://${UAMS_API_HOST:-127.0.0.1}:${UAMS_API_PORT:-8000}/ready" >/dev/null 2>&1; then
      echo "Readiness: ready"
    else
      echo "Readiness: not ready"
    fi
    ;;
  migrate)
    require_venv
    start_infra
    shift
    PYTHONPATH="$WATCHER_DIR" exec "$VENV_DIR/bin/python" \
      "$WATCHER_DIR/scripts/migrate_control_plane.py" "$@"
    ;;
  embed-upgrade)
    require_venv
    start_infra
    shift
    PYTHONPATH="$WATCHER_DIR" exec "$VENV_DIR/bin/python" \
      "$WATCHER_DIR/scripts/embed_upgrade.py" "$@"
    ;;
  lint)
    require_venv
    shift
    PYTHONPATH="$WATCHER_DIR" exec "$VENV_DIR/bin/python" \
      "$WATCHER_DIR/scripts/lint_vault.py" "$@"
    ;;
  projection-status)
    require_venv
    start_infra
    curl -fsS "http://${UAMS_API_HOST:-127.0.0.1}:${UAMS_API_PORT:-8000}/projection-status" | python3 -m json.tool 2>/dev/null || curl -sS "http://${UAMS_API_HOST:-127.0.0.1}:${UAMS_API_PORT:-8000}/projection-status"
    ;;
  index)
    require_venv
    start_infra
    (cd "$WATCHER_DIR" && "$VENV_DIR/bin/python" scripts/reindex_vault.py)
    ;;
  logs)
    tail -n 80 "$WATCHER_DIR/api.log" "$WATCHER_DIR/watcher.log" 2>/dev/null || true
    ;;
  mcp)
    require_venv
    export UAMS_API_URL="${UAMS_API_URL:-http://localhost:${UAMS_API_PORT:-8000}}"
    exec "$VENV_DIR/bin/python" -m uams_sdk.mcp_server
    ;;
  mcp-config)
    require_venv
    "$VENV_DIR/bin/python" "$WATCHER_DIR/scripts/mcp_config.py" "${2:-all}"
    ;;
  doctor)
    require_venv
    "$VENV_DIR/bin/python" "$WATCHER_DIR/scripts/doctor.py"
    ;;
  integrate)
    require_venv
    shift
    "$VENV_DIR/bin/python" "$WATCHER_DIR/scripts/auto_integrate.py"
    ;;
  *)
    usage
    exit 1
    ;;
esac
